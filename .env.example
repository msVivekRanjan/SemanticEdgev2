# ── Django core ───────────────────────────────────────────────────────────────
SECRET_KEY=your-secret-key-here-replace-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ── Database (SQLite by default; override for Postgres in production) ─────────
# DATABASE_URL=postgres://user:pass@localhost:5432/semanticedge

# ── YOLOv8 model path (relative to repo root or absolute) ────────────────────
YOLO_MODEL_PATH=yolov8n.pt
YOLO_CONF_THRESHOLD=0.40
YOLO_DEVICE=cpu

# ── Camera sources (never commit real RTSP URLs with credentials) ─────────────
# Camera source can be:
#   - A webcam index: "0"
#   - An RTSP URL:    "rtsp://user:password@192.168.1.100:554/stream"
# These are stored per-Camera in the DB; the DB credential is managed here:
# DB_PASSWORD=your-db-password
